<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title><%= player.name %></title>
  </head>
  <body>
    <div class="player_container">
      <div class="player_info">
        <h1><%= player.name %> Profile</h1>
        <h3>Name :</h3>
        <h4><%= player.name %></h4>

        <h3>Nationality :</h3>
        <h4><%= player.nationality %></h4>

        <h3>Team :</h3>
        <h4><%= player.team ? player.team.name : "no team" %></h4>

        <h3>Position :</h3>
        <h4><%= player.position %></h4>

        <h3>Rating :</h3>
        <h4><%= player.rating %></h4>
      </div>

      <div class="player_profile">
        <img src="/upload/<%= player.image %>" alt="Player Image" />
      </div>
    </div>

    <% if(league.manager._id.equals(user._id)) {%>
    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>/trade?_method=PUT"
      method="POST"
    >
      <label for="trade_team">trade team</label>
      <input type="text" name="trade_team" id="trade_team" required />
      <button type="submit">Submit</button>
    </form>

    <a
      href="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>/edit"
      >Edit Player</a
    >

    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>?_method=DELETE"
      method="POST"
    >
      <button type="submit">Delete Player</button>
    </form>
    <% } else { %>
    <br />
    <h4>You have view-only access. <%= user.username %></h4>
    <% } %>
  </body>
</html>
