<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title><%= player.name %></title>
  </head>
  <body>
    <table class="simple-table">
      <!--row 1-->
      <tr>
        <th class="team-name" colspan="4">
          Team Name: <%= player.team ? player.team.name : "no team" %>
        </th>
      </tr>
      <!--row 2-->
      <tr>
        <th>Profile</th>
        <th>Name</th>
        <th>Nationality</th>
        <th>Position</th>
        <th>Rating</th>
      </tr>
      <tr>
        <td><img src="/upload/<%= player.image %>" width="20%" /></td>
        <td><%= player.name %></td>
        <td><%= player.nationality %></td>
        <td><%= player.position %></td>
        <td><%= player.rating %></td>
      </tr>
    </table>
    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>/trade?_method=PUT"
      method="POST"
    >
      <label for="trade_team">trade team</label>
      <input type="text" name="trade_team" id="trade_team" required />
      <button type="submit">Submit</button>
    </form>

    <a
      href="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>/edit"
      >Edit Player</a
    >

    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>/players/<%= player._id %>?_method=DELETE"
      method="POST"
    >
      <button type="submit">Delete Player</button>
    </form>
  </body>
</html>
