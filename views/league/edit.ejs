<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Edit league</title>
  </head>
  <body>
  <div class="header-bar"><%- include('../partials/_nav.ejs') %></div>
      <div class="edit-page">
      <div class="edit-form-container-1">
        <div class="edit-form-container-2">
          <h1>Edit League</h1>
          <form action="/leagues/<%= league._id  %>?_method=PUT" method="POST">
            <label for="league-name">League Name: </label>
            <input type="text" name="league" id="league-name" value="<%= league.league  %>"/>
            <label for="country">Country:</label>
            <input type="text" name="country" id="country" value="<%= league.country  %>"/>
            
            <button type="submit">Update League</button>
          </form>
        </div>
      </div>
    </div>  
  </body>
</html>
