<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Leagues</title>
  </head>
  <body>
  <div class="header-bar"><%- include('../partials/_nav.ejs') %></div>
  
  <div class="home"> 
  
    <div class="page-header">
      <p>Leagues: </p>
    </div>  

      <div class="leagues-list">
        <% league.forEach((league)=> { %>
          <div class="league-card">
            <h2><a href="/leagues/<%= league._id %>">
            <%= league.league %></a></h2>
            <div class="manager-info">
              <p>Managed by <%= league.manager.username %></p>
            </div>
          </div>
          <% }) %>
      </div>
    </div>
    <section class="add-show">
      <a href="/leagues/new" class="add-league-btn">Add new League</a>
    </section>
  </body>
</html>
