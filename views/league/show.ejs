<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>league show</title>
  </head>
  <body>
    <div class="header-bar"><%- include('../partials/_nav.ejs') %></div>
    <h1><%= league.league %> has these teams:</h1>
    <table class="simple-table">
      <!--row 1-->
      <tr>
        <th class="team-name" colspan="6">Teams</th>
      </tr>
      <!--row 2-->
      <tr>
        <th>Number</th>
        <th>Name</th>
        <th>Coach</th>
      </tr>
      <% league.teams.forEach((team, index) => { %>
      <tr
        onclick="window.location='/leagues/<%= league._id %>/teams/<%= team._id %>'"
      >
        <td><%= index %></td>
        <td><%= team.name %></td>
        <td><%= team.coach %></td>
      </tr>
      <% }) %>
    </table>
    <% if(league.manager._id.equals(user._id)) {%>
    <section class="buttons-show">  
      <div class="b-1"><a href="/leagues/<%= league._id %>/teams/new">Add new Team</a></div>
      <div class="b-2"><a href="/leagues/<%= league._id %>/edit">Edit</a></div>
      <div class="b-3"><form action="/leagues/<%= league._id %>?_method=DELETE" method="POST">
        <button type="submit">Delete League</button>
      </form></div>
    </section>
    <% } %>
  </body>
</html>
