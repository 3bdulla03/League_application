<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>league show</title>
  </head>
  <body>
    <h1><%= league.league %> has these teams:</h1>
    <a href="/leagues/<%= league._id %>/teams/new">Add new Team</a>
    <br />
    <a href="/leagues/<%= league._id %>/edit">Edit</a>
    <br />
    <table class="simple-table">
      <!--row 1-->
      <tr>
        <th class="team-name" colspan="6">League: <%= league.name %></th>
      </tr>
      <!--row 2-->
      <tr>
        <th>Number</th>
        <th>Name</th>
        <th>Coach</th>
      </tr>
      <% teams.forEach((team, index) => { %>
      <tr
        onclick="window.location='/leagues/<%= league._id %>/teams/<%= team._id %>'"
      >
        <td><%= index %></td>
        <td><%= team.name %></td>
        <td><%= team.coach %></td>
      </tr>
      <% }) %>
    </table>
    <form action="/leagues/<%= league._id %>?_method=DELETE" method="POST">
      <button type="submit">Delete League</button>
    </form>
  </body>
</html>
