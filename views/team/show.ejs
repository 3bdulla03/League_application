<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Team-details</title>
  </head>
  <body>
    <%- include("../partials/_nav.ejs") %>
    <h1>Details</h1>
    <br />

    <h2>Team :</h2>
    <h3><%=team.name%></h3>

    <h2>Coach :</h2>
    <h3><%= team.coach %></h3>
    <br /><br />

    <% if(user._id) {%>
    <a href="/leagues/<%= league._id %>/teams/<%= team._id %>/edit"
      ><button>edit</button></a
    >
    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>/delete?_method=DELETE"
      method="POST"
    >
      <button type="submit">delete</button>
    </form>
    <%}else{ %>
    <p>Task not for u , <%= user.username %></p>
    <% } %>
  </body>
</html>
