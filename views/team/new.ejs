<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <title>new-team</title>
</head>
<body>
  <%- include("../partials/_nav.ejs") %>
    <div class="create-page">
    <div class="add-form-container-1">
      <div class="add-form-container-2">
        <h1>Add New Team</h1>
        <form action="/leagues/<%= league._id %>/teams" method="post">

          <label for="name">Team-name:</label><br>
          <input type="text" name="name" id="name"><br>

          <label for="coach">coach</label><br>
          <input type="text" name="coach" id="coach"><br>

          <button type="submit">add-Team</button>
        </form>
      </div>  
    </div>  
  </div>  
</body>
</html>
