<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>edit-Team</title>
  </head>
  <body>
      <div class="header-bar"><%- include('../partials/_nav.ejs') %></div>
      <div class="edit-page">
      <div class="edit-form-container-1">
        <div class="edit-form-container-2">
          <h1>editing-Team</h1>
          <form
            action="/leagues/<%= league._id %>/teams/<%= team._id %>?_method=PUT"
            method="POST">
            <label for="name">Team-name:</label><br />
            <input type="text" name="name" id="name" value="<%= team.name %>" /><br />

            <label for="coach">coach</label><br />
            <input
              type="text"
              name="coach"
              id="coach"
              value="<%= team.coach %>"
            />
            <button type="submit">Update</button>
          </form>
        </div>  
      </div>  
    </div>  
  </body>
</html>
