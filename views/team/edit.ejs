<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>edit-Team</title>
  </head>
  <body>
    <h1>editing-Team</h1>
    <form
      action="/leagues/<%= league._id %>/teams/<%= team._id %>?_method=PUT"
      method="POST"
    >
      <label for="name">Team-name:</label><br />
      <input type="text" name="name" id="name" value="<%= team.name %>" /><br />

      <label for="coach">coach</label><br />
      <input
        type="text"
        name="coach"
        id="coach"
        value="<%= team.coach %>"
      /><br />

      <button type="submit">edit</button>
    </form>
  </body>
</html>
